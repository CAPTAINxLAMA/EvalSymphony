{% extends 'base.html.twig' %}

{% block title %}Les Photos{% endblock %}

{% block body %}
    <h1>Les Photos</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Date de Prise de Vue</th>
                <th>Fichier</th>
                <th>Etat de l'Oeuvre</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for photo in photos %}
            <tr>
                <td>{{ photo.id }}</td>
                <td>{{ photo.datePriseVue ? photo.datePriseVue|date('Y-m-d') : '' }}</td>
                <td><img src= "/{{ photo.nomFichier }}" alt="Photo de {{ photo.nomFichier }}" width="100"></td>
                <td>{{ photo.etatOeuvre }}</td>
                <td>
                    <a class="btn btn-warning" href="{{ path('app_photo_edit', {'id': photo.id}) }}">Modifier</a>
                    {{ include('photo/_delete_form.html.twig', {'button_label': 'Supprimer'}) }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Aucune Photo trouvée</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="btn btn-primary" href="{{ path('app_photo_new') }}">Ajouter une nouvelle Photo</a>
{% endblock %}
