{% extends 'base.html.twig' %}

{% block title %}Les Lieux{% endblock %}

{% block body %}
    <h1>Les Lieux</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Adresse</th>
                <th>Quartier</th>
                <th>Latitude</th>
                <th>Longitude</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for lieu in lieus %}
            <tr>
                <td>{{ lieu.id }}</td>
                <td>{{ lieu.nom }}</td>
                <td>{{ lieu.adresse }}</td>
                <td>{{ lieu.quartier }}</td>
                <td>{{ lieu.latitude }}</td>
                <td>{{ lieu.longitude }}</td>
                <td>
                    <a class="btn btn-warning" href="{{ path('app_lieu_edit', {'id': lieu.id}) }}">Modifier</a>
                    {{ include('lieu/_delete_form.html.twig', {'button_label': 'Supprimer'}) }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">Aucun Lieu trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="btn btn-primary" href="{{ path('app_lieu_new') }}">Ajouter un nouveau Lieu</a>

    <a class="btn btn-secondary" href="{{ path('app_oeuvre_new') }}">Retour</a>

{% endblock %}
