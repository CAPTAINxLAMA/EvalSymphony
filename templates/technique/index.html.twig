{% extends 'base.html.twig' %}

{% block title %}Les Techniques{% endblock %}

{% block body %}
    <h1>Les Techniques</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for technique in techniques %}
            <tr>
                <td>{{ technique.id }}</td>
                <td>{{ technique.nom }}</td>
                <td>
                    <a class="btn btn-warning" href="{{ path('app_technique_edit', {'id': technique.id}) }}">Modifier</a>
                    {{ include('technique/_delete_form.html.twig', {'button_label': 'Supprimer'}) }}
                
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Aucune Technique trouvée</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="btn btn-primary" href="{{ path('app_technique_new') }}">Ajouter une nouvelle Technique</a>
    
    <a class="btn btn-secondary" href="{{ path('app_oeuvre_new') }}">Retour</a>

{% endblock %}
