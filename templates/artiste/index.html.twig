{% extends 'base.html.twig' %}

{% block title %}Les Artistes{% endblock %}

{% block body %}
    <h1>Les Artistes</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Pseudonyme</th>
                <th>Nom Réel</th>
                <th>Bio</th>
                <th>Nationalité</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for artiste in artistes %}
            <tr>
                <td>{{ artiste.id }}</td>
                <td>{{ artiste.pseudonyme }}</td>
                <td>{{ artiste.nomReel }}</td>
                <td>{{ artiste.bio }}</td>
                <td>{{ artiste.nationalite }}</td>
                <td>
                    <a class="btn btn-warning" href="{{ path('app_artiste_edit', {'id': artiste.id}) }}">Modifier</a>
                    {{ include('artiste/_delete_form.html.twig', {'button_label': 'Supprimer'}) }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Aucun artiste trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="btn btn-primary" href="{{ path('app_artiste_new') }}">Ajouter un nouvel Artiste</a>

    <a class="btn btn-secondary" href="{{ path('app_oeuvre_new') }}">Retour</a>

{% endblock %}
